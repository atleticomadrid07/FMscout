# Normalize text files to LF in the repo.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# FM .rtf exports: keep bytes exactly as FM wrote them, so parser tests
# see real line endings and encoding.
*.rtf -text

# Binary files: never diff or normalize.
*.db binary
*.sqlite binary
*.sqlite3 binary
*.fm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
