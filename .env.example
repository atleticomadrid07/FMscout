# Copy to .env and fill in. Never commit .env.

# PitchAPI key. Server-side only: read by the sync CLI.
# Never used by the web app's frontend, never logged.
PITCHAPI_API_KEY=

# SQLAlchemy database URL (path is relative to the repo root).
DATABASE_URL=sqlite:///data/scouting.db

# Sync throttle in requests per second. PitchAPI's burst limit is unpublished,
# so keep this conservative.
SYNC_MAX_RPS=1

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
