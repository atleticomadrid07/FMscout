# Copy to .env and fill in. Never commit .env.
# Relative paths are resolved from backend/, where the commands are run.

# PitchAPI key. Server-side only: read by the sync CLI.
# Never used by the web app's frontend, never logged.
PITCHAPI_API_KEY=

# SQLAlchemy URL for scouting.db (the canonical database).
DATABASE_URL=sqlite:///data/scouting.db

# raw.db: compressed cache of every API response. Only the sync CLI uses it.
RAW_DB_PATH=data/raw.db

# Sync throttle in requests per second (max 5). PitchAPI's burst limit is
# unpublished, so keep this conservative.
SYNC_MAX_RPS=1

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO